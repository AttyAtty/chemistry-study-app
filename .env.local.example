# Resend API key (do not commit a real key)
RESEND_API_KEY=

# Feedback recipient is configured in src/app/api/feedback/route.ts:
# chemica1chemica1chemica@gmail.com (CHEMICA_FEEDBACK_TO_EMAIL is no longer used)

# Verified Resend sender, e.g. Chemica <feedback@chemica.app>
CHEMICA_FEEDBACK_FROM_EMAIL=

# Supabase public connection foundation (no secret/service-role key)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Canonical public origin. Set to https://chemica.app on the production deployment after DNS/TLS are ready.
# When empty, the app uses Vercel's deployment host or localhost for metadata and sitemap URLs.
NEXT_PUBLIC_APP_URL=https://chemica.app
