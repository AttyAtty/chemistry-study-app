# Resend API key (do not commit a real key)
RESEND_API_KEY=

# Feedback recipient is configured in src/app/api/feedback/route.ts:
# chemica1chemica1chemica@gmail.com (CHEMICA_FEEDBACK_TO_EMAIL is no longer used)

# Verified Resend sender, e.g. Chemica <feedback@your-domain.example>
CHEMICA_FEEDBACK_FROM_EMAIL=

# Supabase public connection foundation (no secret/service-role key)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
